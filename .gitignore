# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the example env
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.auth/

# prisma generated client
/src/generated/

# question banks transcribed from books: kept out of the public repo, loaded into the database
/Doc/question-bank/
/Doc/study-resource/*.zip

# Local scratch files and screenshots, never committed.
/temp/
/Doc/habbit.png

# Lecture books are paid material: keep the source books and slices local.
/Doc/study-resource/লেকচার বুক*
/Doc/lecture-books/
